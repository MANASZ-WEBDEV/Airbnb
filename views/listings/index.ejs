<% layout("/layouts/boilerplate") %>
<style>
  html, body {
    overflow-x: hidden !important;
    width: 100vw;
    box-sizing: border-box;
  }
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    position: relative;
    width: 100vw;
    overflow-x: hidden;
    box-sizing: border-box;
  }
  .filter {
    text-align: center;
    margin-right: 1.2rem;
    margin-top: 1rem;
    opacity: 0.8;
    text-decoration: none;
    color: inherit;
    transition: border-bottom 0.2s, color 0.2s;
    white-space: nowrap;
    font-size: 1rem;
    box-sizing: border-box;
  }
  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
  .filter p {
    font-size: 0.8rem;
    margin-bottom: 0;
  }
  .filter.active {
    border-bottom: 2px solid #fe424d;
    opacity: 1;
    color: #fe424d;
  }
  .all {
    margin-left: 1rem;
  }
  .dropdown {
    position: relative;
    display: inline-block;
    margin-top: 1rem;
  }
  .dropdown-content {
    display: none;
    position: absolute;
    background-color: #fff;
    min-width: 160px;
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
    z-index: 1;
    right: 0;
    border-radius: 8px;
    padding: 0.5rem 0;
  }
  .dropdown-content a {
    color: #222;
    padding: 8px 16px;
    text-decoration: none;
    display: block;
    text-align: left;
    font-size: 1rem;
  }
  .dropdown-content a.active {
    color: #fe424d;
    font-weight: bold;
  }
  .dropdown:hover .dropdown-content {
    display: block;
  }
  @media (max-width: 700px) {
    #filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0.2rem;
    }
    .filter {
      margin-right: 0.5rem;
      font-size: 0.95rem;
    }
    .hide-mobile {
      display: none !important;
    }
    .dropdown {
      display: inline-block;
    }
  }
  .tax-info{
    display: none;
  }
  .tax-toggle {
    border: 1.5px solid #fe424d;
    border-radius: 2rem;
    background: #fff;
    box-shadow: 0 2px 8px rgba(254,66,77,0.08);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 1.5rem;
    margin-left: auto;
    margin-right: 2rem;
    font-size: 1.1rem;
    font-weight: 500;
    max-width: 350px;
    transition: box-shadow 0.2s;
  }
  .tax-toggle:hover {
    box-shadow: 0 4px 16px rgba(254,66,77,0.13);
  }
  .tax-toggle input[type="checkbox"] {
    accent-color: #fe424d;
    width: 2rem;
    height: 1.2rem;
    margin-left: 0.5rem;
  }

  @media (max-width: 700px) {
    .tax-toggle {
      font-size: 0.95rem;
      padding: 0.5rem 0.7rem;
      max-width: 90vw;
      margin: 0.5rem auto 1rem auto;
      justify-content: center;
    }
    .tax-toggle input[type="checkbox"] {
      width: 1.5rem;
      height: 1rem;
      margin-left: 0.3rem;
    }
  }
</style>
<div id="filters">
  <a href="/listings" class="filter all <%= !selectedCategory ? 'active' : '' %>">
    <div><i class="fa-solid fa-globe"></i></div>
    <p>All</p>
  </a>
  <a href="/listings?category=trending" class="filter <%= selectedCategory === 'trending' ? 'active' : '' %>">
    <div><i class="fas fa-fire"></i></div>
    <p>Trending</p>
  </a>
  <a href="/listings?category=rooms" class="filter <%= selectedCategory === 'rooms' ? 'active' : '' %>">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </a>
  <a href="/listings?category=iconic" class="filter <%= selectedCategory === 'iconic' ? 'active' : '' %>">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </a>
  <a href="/listings?category=mountains" class="filter <%= selectedCategory === 'mountains' ? 'active' : '' %>">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </a>
  <!-- Hide these on mobile, show in dropdown -->
  <a href="/listings?category=castles" class="filter hide-mobile <%= selectedCategory === 'castles' ? 'active' : '' %>">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </a>
  <a href="/listings?category=pools" class="filter hide-mobile <%= selectedCategory === 'pools' ? 'active' : '' %>">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </a>
  <a href="/listings?category=camping" class="filter hide-mobile <%= selectedCategory === 'camping' ? 'active' : '' %>">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </a>
  <a href="/listings?category=farms" class="filter hide-mobile <%= selectedCategory === 'farms' ? 'active' : '' %>">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </a>
  <a href="/listings?category=arctic" class="filter hide-mobile <%= selectedCategory === 'arctic' ? 'active' : '' %>">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arctic</p>
  </a>
  <!-- Dropdown for extra categories on mobile -->
  <div class="dropdown">
    <a class="filter dropdown-toggle" href="#" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false" style="display: none;">
      <div><i class="fa-solid fa-ellipsis-h"></i></div>
      <p>More</p>
    </a>
    <div class="dropdown-content">
      <a href="/listings?category=castles" class="<%= selectedCategory === 'castles' ? 'active' : '' %>"><i class="fa-brands fa-fort-awesome"></i> Castles</a>
      <a href="/listings?category=pools" class="<%= selectedCategory === 'pools' ? 'active' : '' %>"><i class="fa-solid fa-person-swimming"></i> Amazing Pools</a>
      <a href="/listings?category=camping" class="<%= selectedCategory === 'camping' ? 'active' : '' %>"><i class="fa-solid fa-campground"></i> Camping</a>
      <a href="/listings?category=farms" class="<%= selectedCategory === 'farms' ? 'active' : '' %>"><i class="fa-solid fa-cow"></i> Farms</a>
      <a href="/listings?category=arctic" class="<%= selectedCategory === 'arctic' ? 'active' : '' %>"><i class="fa-regular fa-snowflake"></i> Arctic</a>
    </div>
  </div>
  <div class="tax-toggle ms-auto" style="background: #fff; border: 1.5px solid #fe424d; border-radius: 2rem; box-shadow: 0 2px 8px rgba(254,66,77,0.08); display: flex; align-items: center; gap: 1.2rem; padding: 0.7rem 1.5rem; margin-left: auto; margin-right: 2rem; font-size: 1.1rem; font-weight: 500; max-width: 500px;">
    <label class="form-check-label" for="flexSwitchCheckDefault" id="taxToggleLabel">Display total after taxes</label>
    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
  </div>
</div>
<script>
// Show dropdown only on mobile
function handleDropdownDisplay() {
  const dropdownToggle = document.querySelector('.dropdown-toggle');
  if (window.innerWidth <= 700) {
    dropdownToggle.style.display = 'inline-block';
  } else {
    dropdownToggle.style.display = 'none';
  }
}
window.addEventListener('resize', handleDropdownDisplay);
window.addEventListener('DOMContentLoaded', handleDropdownDisplay);
</script>
<div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-3" style="width:100vw;overflow-x:hidden;box-sizing:border-box;">
  <% for (let listing of alllisting) { %>
  <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col listing-card">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top"
        alt="listing_image"
        style="height: 20rem"
      />
      <div class="card-img-overlay">
        <!-- abcd -->
      </div>
      <div class="card-body">
        <p class="card-text">
          <b><%= listing.title %> </b> <br />
          <% if (Array.isArray(listing.category)) { %>
            <% listing.category.forEach(function(cat) { %>
              <span class="badge bg-secondary"><%= cat %></span>
            <% }); %>
          <% } else if (listing.category) { %>
            <span class="badge bg-secondary"><%= listing.category %></span>
          <% } %><br />
          <span class="price-label">
            <span style="font-weight:600;" class="main-price" data-base="<%= listing.price %>"></span>
            <span style="font-size:0.9rem;color:#888;">/ night</span>
          </span>
        </p>
      </div>
    </div>
  </a>
  <% } %>
</div>

<script>
  // Toggle to show price after 18% GST or base price
  const taxToggle = document.getElementById('flexSwitchCheckDefault');
  const taxToggleLabel = document.getElementById('taxToggleLabel');
  function updatePrices() {
    const priceSpans = document.querySelectorAll('.main-price');
    for (let priceSpan of priceSpans) {
      const base = parseFloat(priceSpan.getAttribute('data-base'));
      if (!isNaN(base)) {
        if (taxToggle.checked) {
          // Show after-tax price (18% GST)
          const afterTax = Math.round(base * 1.18);
          priceSpan.textContent = `₹ ${afterTax.toLocaleString("en-IN")}`;
        } else {
          // Show base price
          priceSpan.textContent = `₹ ${base.toLocaleString("en-IN")}`;
        }
      }
    }
    taxToggleLabel.textContent = "Display total after taxes";
  }
  taxToggle.addEventListener('change', updatePrices);
  window.addEventListener('DOMContentLoaded', updatePrices);
</script>