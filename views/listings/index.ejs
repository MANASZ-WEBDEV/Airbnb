<% layout("/layouts/boilerplate") %>
<style>
  html, body {
    overflow-x: hidden !important;
    width: 100vw;
    box-sizing: border-box;
  }
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    position: relative;
    width: 100vw;
    overflow-x: hidden;
    box-sizing: border-box;
  }
  .tax-toggle label {
    white-space: nowrap;
    font-size: 1rem;
    margin-bottom: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
    display: flex;
    align-items: center;
    height: 100%;
    vertical-align: middle;
    padding: 0;
    margin: 0;
  }
  @media (max-width: 700px) {
    .tax-toggle label {
      font-size: 0.95rem;
      max-width: 120px;
    }
  }
  .filter {
    text-decoration: none;
    color: #222;
    transition: border-bottom 0.2s, color 0.2s;
    white-space: nowrap;
    font-size: 1rem;
    box-sizing: border-box;
    text-align: center;
    margin-right: 1.2rem;
    margin-top: 1rem;
    opacity: 0.8;
  }
  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
  .filter p {
    font-size: 0.8rem;
    margin-bottom: 0;
  }
  .filter.active {
    border-bottom: 2px solid #fe424d;
    opacity: 1;
    color: #fe424d;
  }
  .all {
    margin-left: 1rem;
  }
  .dropdown {
    position: relative;
    display: inline-block;
    margin-top: 1rem;
  }
  .dropdown-content {
    display: none;
    position: absolute;
    background: #fff;
    min-width: 220px;
    box-shadow: 0 8px 32px 0 rgba(0,0,0,0.18), 0 1.5px 6px 0 rgba(0,0,0,0.10);
    z-index: 1002;
    left: 0;
    border-radius: 18px;
    padding: 0.9rem 0.2rem;
    top: 2.2rem;
    border: 1.5px solid #eee;
    animation: dropdown-fade-in 0.18s cubic-bezier(.4,0,.2,1);
  }
  @keyframes dropdown-fade-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .dropdown-content a {
    color: #222;
    padding: 18px 18px 18px 0.8rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 1rem;
    text-align: left;
    font-size: 1.18rem;
    border-radius: 10px;
    transition: background 0.15s, color 0.15s;
    font-weight: 600;
    margin: 0.2rem 0;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    letter-spacing: 0.01em;
  }
  .dropdown-content a.active, .dropdown-content a:hover {
    color: #fe424d;
    font-weight: 700;
    background: #fbeaec;
    box-shadow: 0 2px 8px rgba(254,66,77,0.08);
  }
  .dropdown-content a i {
    font-size: 1.35rem;
    min-width: 28px;
    text-align: center;
    color: #fe424d;
  }
  .dropdown-toggle {
    font-size: 1.13rem;
    font-weight: 600;
    color: #222;
    background: #fff;
    border: 1.5px solid #eee;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    padding: 0.5rem 1.2rem;
    margin-bottom: 0.2rem;
    transition: box-shadow 0.15s, border 0.15s;
  }
  .dropdown-toggle:active, .dropdown-toggle:focus {
    background: #fbeaec;
    border-color: #fe424d;
    box-shadow: 0 4px 16px rgba(254,66,77,0.13);
  }
  .dropdown.mobile-dropdown { z-index: 2000; }
  @media (max-width: 700px) {
    .dropdown-content {
      min-width: 90vw;
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      top: 2.5rem;
      box-shadow: 0 8px 32px 0 rgba(0,0,0,0.22), 0 1.5px 6px 0 rgba(0,0,0,0.13);
      z-index: 2000;
    }
    .dropdown-content a {
      font-size: 1.13rem;
      padding: 18px 18px;
      margin: 0 2px;
    }
    .dropdown.mobile-dropdown { z-index: 3000; }
    .row.row-cols-lg-3.row-cols-md-3.row-cols-sm-1 {
      width: 100vw !important;
      max-width: 100vw !important;
      margin: 0 !important;
      padding: 0 0.5rem !important;
    }
    .listing-card {
      width: 100% !important;
      max-width: 100vw !important;
      margin-left: auto !important;
      margin-right: auto !important;
      box-sizing: border-box;
    }
  }
  @media (max-width: 700px) {
    #filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0.2rem;
    }
    .filter {
      margin-right: 0.5rem;
      font-size: 0.95rem;
    }
    .hide-mobile {
      display: none !important;
    }
    .dropdown {
      display: inline-block;
    }
  }
  .tax-info{
    display: none;
  }
  .tax-toggle {
    border: 1.5px solid #fe424d;
    border-radius: 2rem;
    background: #fff;
    box-shadow: 0 2px 8px rgba(254,66,77,0.08);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.3rem 1.2rem;
    margin-left: auto;
    margin-right: 2rem;
    font-size: 1.1rem;
    font-weight: 500;
    max-width: 350px;
    transition: box-shadow 0.2s;
    height: 2.4rem;
    min-height: 2.4rem;
  }
  .tax-toggle:hover {
    box-shadow: 0 4px 16px rgba(254,66,77,0.13);
  }
  .tax-toggle input[type="checkbox"] {
    accent-color: #fe424d;
    width: 2rem;
    height: 1.2rem;
    margin-left: 0.5rem;
  }

  @media (max-width: 700px) {
    .tax-toggle {
      font-size: 0.95rem;
      padding: 0.5rem 0.7rem;
      max-width: 90vw;
      margin: 0.5rem auto 1rem auto;
      justify-content: center;
    }
    .tax-toggle input[type="checkbox"] {
      width: 1.5rem;
      height: 1rem;
      margin-left: 0.3rem;
    }
  }
</style>
<div id="filters" style="margin-bottom: 1.2rem;">
  <a href="/listings" class="filter all <%= !selectedCategory ? 'active' : '' %>">
    <div><i class="fa-solid fa-globe"></i></div>
    <p>All</p>
  </a>
  <a href="/listings?category=trending" class="filter <%= selectedCategory === 'trending' ? 'active' : '' %>">
    <div><i class="fas fa-fire"></i></div>
    <p>Trending</p>
  </a>
  <a href="/listings?category=rooms" class="filter <%= selectedCategory === 'rooms' ? 'active' : '' %>">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </a>
  <a href="/listings?category=iconic" class="filter <%= selectedCategory === 'iconic' ? 'active' : '' %>">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </a>
  <a href="/listings?category=mountains" class="filter <%= selectedCategory === 'mountains' ? 'active' : '' %>">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </a>
  <!-- Hide these on mobile, show in dropdown -->
  <a href="/listings?category=castles" class="filter hide-mobile <%= selectedCategory === 'castles' ? 'active' : '' %>">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </a>
  <a href="/listings?category=pools" class="filter hide-mobile <%= selectedCategory === 'pools' ? 'active' : '' %>">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </a>
  <a href="/listings?category=camping" class="filter hide-mobile <%= selectedCategory === 'camping' ? 'active' : '' %>">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </a>
  <a href="/listings?category=farms" class="filter hide-mobile <%= selectedCategory === 'farms' ? 'active' : '' %>">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </a>
  <a href="/listings?category=arctic" class="filter hide-mobile <%= selectedCategory === 'arctic' ? 'active' : '' %>">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arctic</p>
  </a>
  <!-- Dropdown for extra categories on mobile -->
  <div class="dropdown mobile-dropdown">
    <button class="filter dropdown-toggle" id="dropdownMenuButton" aria-expanded="false" tabindex="0">
      <div><i class="fa-solid fa-ellipsis-h"></i></div>
      <p>More</p>
    </button>
    <div class="dropdown-content" id="dropdownContent">
      <a href="/listings?category=castles" class="<%= selectedCategory === 'castles' ? 'active' : '' %>"><i class="fa-brands fa-fort-awesome"></i> Castles</a>
      <a href="/listings?category=pools" class="<%= selectedCategory === 'pools' ? 'active' : '' %>"><i class="fa-solid fa-person-swimming"></i> Amazing Pools</a>
      <a href="/listings?category=camping" class="<%= selectedCategory === 'camping' ? 'active' : '' %>"><i class="fa-solid fa-campground"></i> Camping</a>
      <a href="/listings?category=farms" class="<%= selectedCategory === 'farms' ? 'active' : '' %>"><i class="fa-solid fa-cow"></i> Farms</a>
      <a href="/listings?category=arctic" class="<%= selectedCategory === 'arctic' ? 'active' : '' %>"><i class="fa-regular fa-snowflake"></i> Arctic</a>
    </div>
  </div>
  <div class="tax-toggle ms-auto">
    <label class="form-check-label" for="flexSwitchCheckDefault" id="taxToggleLabel">Show total incl. taxes</label>
    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
  </div>
</div>
<script>
// Mobile-friendly More... dropdown toggle and hide More when navbar is open
document.addEventListener('DOMContentLoaded', function() {
  const dropdownBtn = document.getElementById('dropdownMenuButton');
  const dropdownContent = document.getElementById('dropdownContent');
  const navbarCollapse = document.getElementById('navbarNavAltMarkup');
  const moreWrapper = dropdownBtn.closest('.mobile-dropdown');

  function closeDropdown(e) {
    if (!dropdownBtn.contains(e.target) && !dropdownContent.contains(e.target)) {
      dropdownContent.style.display = 'none';
      document.removeEventListener('click', closeDropdown);
    }
  }
  dropdownBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    dropdownContent.style.display = dropdownContent.style.display === 'block' ? 'none' : 'block';
    if (dropdownContent.style.display === 'block') {
      setTimeout(() => document.addEventListener('click', closeDropdown), 0);
    }
  });
  // Show/hide More... button based on screen size
  function handleDropdownDisplay() {
    if (window.innerWidth <= 700) {
      dropdownBtn.style.display = 'inline-block';
    } else {
      dropdownBtn.style.display = 'none';
      dropdownContent.style.display = 'none';
    }
  }
  window.addEventListener('resize', handleDropdownDisplay);
  handleDropdownDisplay();

  // Hide More button when navbar is open (mobile menu)
  if (navbarCollapse && moreWrapper) {
    navbarCollapse.addEventListener('show.bs.collapse', function() {
      moreWrapper.style.display = 'none';
    });
    navbarCollapse.addEventListener('hide.bs.collapse', function() {
      moreWrapper.style.display = '';
    });
  }
});
</script>
<div class="row mt-4 justify-content-center">
  <% for (let listing of alllisting) { %>
  
  <div class="col-12 col-md-6 col-lg-4 d-flex justify-content-center">
    <a href="/listings/<%= listing._id %>" class="listing-link w-100">
      
      <div class="card listing-card h-100">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="listing_image"
        />

        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b><br/>

            <% if (Array.isArray(listing.category)) { %>
              <% listing.category.forEach(function(cat) { %>
                <span class="badge bg-secondary"><%= cat %></span>
              <% }); %>
            <% } else if (listing.category) { %>
              <span class="badge bg-secondary"><%= listing.category %></span>
            <% } %>

            <br/>

            <span class="price-label">
              <span class="main-price" data-base="<%= listing.price %>"></span>
              <span style="font-size:0.9rem;color:#888;">/ night</span>
            </span>
          </p>
        </div>
      </div>

    </a>
  </div>

  <% } %>
</div>

<script>
  // Toggle to show price after 18% GST or base price
  const taxToggle = document.getElementById('flexSwitchCheckDefault');
  const taxToggleLabel = document.getElementById('taxToggleLabel');
  function updatePrices() {
    const priceSpans = document.querySelectorAll('.main-price');
    for (let priceSpan of priceSpans) {
      const base = parseFloat(priceSpan.getAttribute('data-base'));
      if (!isNaN(base)) {
        if (taxToggle.checked) {
          // Show after-tax price (18% GST)
          const afterTax = Math.round(base * 1.18);
          priceSpan.textContent = `₹ ${afterTax.toLocaleString("en-IN")}`;
        } else {
          // Show base price
          priceSpan.textContent = `₹ ${base.toLocaleString("en-IN")}`;
        }
      }
    }
    taxToggleLabel.textContent = "Show total incl. taxes";
  }
  taxToggle.addEventListener('change', updatePrices);
  window.addEventListener('DOMContentLoaded', updatePrices);
</script>